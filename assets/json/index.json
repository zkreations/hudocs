{{- $index := slice -}}

{{- range $i, $page := where .Site.Pages "Section" .Section -}}
  {{- if and .File (ne $page.RelPermalink $.RelPermalink) (or .Title (truncate 120 .Plain)) -}}
    {{- $content := .Content | replaceRE "(?s)<pre[^>]*>.*?</pre>" "" | plainify | replaceRE "\\s{2,}" " " | strings.TrimSpace -}}
    {{- $summary := truncate 100 $content | default (i18n "no_summary") -}}

    {{- $parent := $page -}}
    {{- range seq 10 -}}
      {{- if and $parent.Parent (not $parent.Parent.IsHome) (not $parent.Parent.Parent.IsHome) -}}
        {{- $parent = $parent.Parent -}}
      {{- end -}}
    {{- end -}}

    {{- $parentSection := "" -}}
    {{- with $parent.File -}}
      {{- $parentSection = .ContentBaseName -}}
    {{- else -}}
      {{- $parentSection = $parent.Title -}}
    {{- end -}}

    {{- $index = $index | append (dict
      "id" $i
      "url" $page.RelPermalink
      "summary" $summary
      "title" $page.Title
      "parent" $parentSection
      "content" $content
    ) -}}
  {{- end -}}
{{- end -}}

{
  "documents": {{ $index | jsonify }}
}