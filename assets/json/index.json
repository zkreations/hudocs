{{- $index := slice -}}

{{- range $i, $page := .Site.Pages -}}
  {{- if and .File (or .Title (truncate 120 .Plain)) -}}
    {{- $summary := truncate 120 .Plain | default (i18n "no_summary") -}}

    {{- $parent := $page -}}
    {{- range seq 10 -}}
      {{- if and $parent.Parent (not $parent.Parent.IsHome) (not $parent.Parent.Parent.IsHome) -}}
        {{- $parent = $parent.Parent -}}
      {{- end -}}
    {{- end -}}

    {{- $parentSection := "" -}}
    {{- with $parent.File -}}
      {{- $parentSection = .ContentBaseName -}}
    {{- else -}}
      {{- $parentSection = $parent.Title -}}
    {{- end -}}

    {{- $index = $index | append (dict
      "id" $i
      "url" $page.RelPermalink
      "summary" $summary
      "title" $page.Title
      "parent" $parentSection
    ) -}}
  {{- end -}}
{{- end -}}

{
  "documents": {{ $index | jsonify }}
}