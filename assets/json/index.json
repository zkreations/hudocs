{{- $comma := false -}}
{{- $root := . -}}
[
{{- range $i, $page := where .RegularPagesRecursive "Params.hidden" "ne" true -}}
  {{- $isRedirect := or (isset .Params "redirect") (eq .Params.layout "redirect") -}}
  {{- if and (not $isRedirect) .File (or .Title (truncate 120 .Plain)) -}}
    {{- $content := .Content | replaceRE "(?s)<pre[^>]*>.*?</pre>" "" | plainify | replaceRE "\\s{2,}" " " | strings.TrimSpace -}}
    {{- $summary := truncate 100 $content | default (i18n "no_summary") -}}

    {{- $parent := $page -}}
    {{- range seq 10 -}}
      {{- if and $parent.Parent (ne $parent.Parent $root) (not $parent.Parent.IsHome) -}}
        {{- $parent = $parent.Parent -}}
      {{- end -}}
    {{- end -}}

    {{- $parentSection := "" -}}
    {{- if ne $parent $page -}}
      {{- $parentSection = partial "title" $parent -}}
    {{- end -}}

    {{- if $comma }},{{ end -}}
    {{- (slice $i $page.RelPermalink (partial "title" $page) $parentSection $summary $content) | jsonify -}}
    {{- $comma = true -}}
  {{- end -}}
{{- end -}}
]